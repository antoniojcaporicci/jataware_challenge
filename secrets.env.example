# Copy to secrets.env and fill in locally. Do not commit secrets.env.
#
#   cp secrets.env.example secrets.env
#
# Load before curl or running the service:
#   set -a && source secrets.env && set +a

API_URL=
API_TOKEN=
# Optional: set after POST /sessions, or let challenge_http_cli.py session-create add it.
SESSION_ID=
